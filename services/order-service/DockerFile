# --- build stage ---
FROM golang:1.26-alpine AS builder

WORKDIR /app
COPY go.mod ./
COPY . .
# go mod tidy (not download) because it resolves and locks the full
# transitive dependency graph -- pgx and google/uuid pull in packages not
# yet listed in go.mod, which `go mod download` alone can't resolve.
# Once go.sum is fully committed and stable, this can switch to
# `go mod download` for reproducible, network-free builds.
RUN go mod tidy
RUN CGO_ENABLED=0 GOOS=linux go build -o /order-service .

# --- runtime stage ---
FROM alpine:3.24
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=builder /order-service .

EXPOSE 8080
ENTRYPOINT [ "/app/order-service" ]